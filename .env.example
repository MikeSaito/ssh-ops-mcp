# Example only. Prefer an external private env file and --env-file.
SSH_HOST=203.0.113.10
SSH_PORT=22
SSH_USERNAME=deploy
SSH_AUTH_METHOD=password
SSH_PASSWORD=replace-with-your-password
# Alternative to SSH_PASSWORD; never set both:
# SSH_PASSWORD_FILE=/absolute/private/password.txt
# Get the fingerprint through a trusted console/admin, not an unverified scan.
# Replace this example before connecting:
SSH_HOST_FINGERPRINT_SHA256=SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# For private_key auth:
# SSH_AUTH_METHOD=private_key
# SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
# SSH_KEY_PASSPHRASE_FILE=/absolute/private/passphrase.txt
# For agent auth:
# SSH_AUTH_METHOD=agent
# SSH_AGENT_SOCKET=/absolute/path/to/agent.sock
# On Windows, the OpenSSH named pipe is used if no socket is specified.
# Optional absolute BASE directory; a per-target subdirectory is always appended.
# SSH_MCP_STATE_DIR=/absolute/private/mcp-state
# Root diagnostics require a dedicated unprivileged account:
# SSH_DIAGNOSTIC_USER=mcp-diagnostics
# Unsafe development-only escape hatch (disabled by default):
# SSH_ALLOW_UNVERIFIED_HOST=false
